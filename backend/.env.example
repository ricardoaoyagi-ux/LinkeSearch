# Copy to backend/.env to override defaults (all optional)

# Show the browser window while scanning (useful for debugging)
# LINKESEARCH_HEADLESS=false

# "chrome" = installed Google Chrome with a separate profile; empty = Playwright's bundled Chromium
# LINKESEARCH_BROWSER_CHANNEL=chrome

# Random pause between LinkedIn requests, in seconds
# LINKESEARCH_MIN_DELAY_S=1.5
# LINKESEARCH_MAX_DELAY_S=4.0

# Max result pages per scan (25 jobs each)
# LINKESEARCH_MAX_PAGES=40

# Used only if the "Show all" search of the Jobs tab cannot be found
# LINKESEARCH_FALLBACK_KEYWORDS=software engineer, remote
# LINKESEARCH_FALLBACK_GEO_ID=<geoId da sua região, visto na URL de busca do LinkedIn>

# Triage ("Preparar triagem"): pace of the About fetches, batch size and auto-ignore threshold
# LINKESEARCH_TRIAGE_MIN_DELAY_S=4
# LINKESEARCH_TRIAGE_MAX_DELAY_S=9
# LINKESEARCH_TRIAGE_BATCH_PAUSE_MIN_S=60
# LINKESEARCH_TRIAGE_BATCH_PAUSE_MAX_S=120
# LINKESEARCH_TRIAGE_MAX_PER_RUN=150
# LINKESEARCH_TRIAGE_BATCH_SIZE=25
# LINKESEARCH_TRIAGE_IGNORE_AT_OR_BELOW=59
# Companies always ignored by the triage, comma-separated (e.g. a former employer)
# LINKESEARCH_TRIAGE_BLOCKED_COMPANIES=Empresa A, Empresa B
# Your minimum monthly CLT salary in BRL, given to the AI as context only (not a floor, not part of the fit score)
# LINKESEARCH_TRIAGE_MIN_SALARY=10000
# Fit score at or below this: the AI skips the salary research (returns 0/0/0), which is faster
# LINKESEARCH_TRIAGE_SKIP_SALARY_AT_OR_BELOW=59
