# Copy to backend/.env to override defaults (all optional)

# Show the browser window while scanning (useful for debugging)
# LINKESEARCH_HEADLESS=false

# "chrome" = installed Google Chrome with a separate profile; empty = Playwright's bundled Chromium
# LINKESEARCH_BROWSER_CHANNEL=chrome

# Random pause between LinkedIn requests, in seconds
# LINKESEARCH_MIN_DELAY_S=1.5
# LINKESEARCH_MAX_DELAY_S=4.0

# Max result pages per scan (25 jobs each)
# LINKESEARCH_MAX_PAGES=40

# Used only if the "Show all" search of the Jobs tab cannot be found
# LINKESEARCH_FALLBACK_KEYWORDS=software engineer, remote
# LINKESEARCH_FALLBACK_GEO_ID=<geoId da sua região, visto na URL de busca do LinkedIn>
